{
    "name": "your-vendor/room-service",
    "description": "Room management microservice for multiplayer games",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-mongodb": "^2.0",
        "ext-curl": "*",
        "mongodb/mongodb": "^1.17",
        "predis/predis": "^2.2",
        "php-amqplib/php-amqplib": "^3.6",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start-worker": "php bin/start_game_worker.php",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}